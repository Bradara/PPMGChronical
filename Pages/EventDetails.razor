@page "/events/{Id}"
@using PPMGChronical.Models
@inject Services.ChronicleService ChronicleService
@inject NavigationManager NavigationManager

<div class="container mt-4">
    @if (loading)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (chronicleEvent == null)
    {
        <div class="alert alert-warning">
            Event not found. It may have been deleted.
            <button class="btn btn-link" @onclick="NavigateToEvents">Back to Events</button>
        </div>
    }
    else
    {
        <h1 class="mb-3">@chronicleEvent.Title</h1>

        <div class="row mb-4">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Event Details</h5>
                        <p class="text-muted">@chronicleEvent.Date.ToString("MMMM d, yyyy")</p>
                        <span class="badge bg-secondary mb-3">@chronicleEvent.Category</span>

                        <div class="mb-4">
                            @((MarkupString)FormatDescription(chronicleEvent.Description))
                        </div>

                        @if (chronicleEvent.ImageUrls.Any())
                        {
                            <h6>Images</h6>
                            <div class="row">
                                @foreach (var imageUrl in chronicleEvent.ImageUrls)
                                {
                                    <div class="col-md-4 mb-3">
                                        <img src="@imageUrl" class="img-thumbnail" alt="Event image" />
                                    </div>
                                }
                            </div>
                        }

                        <div class="mt-4">
                            <small class="text-muted">
                                Added by @chronicleEvent.CreatedBy on @chronicleEvent.CreatedAt.ToString("MM/dd/yyyy")
                            </small>
                        </div>
                    </div>
                    <div class="card-footer">
                        <button class="btn btn-primary" @onclick="() => EditEvent(chronicleEvent.Id)">Edit</button>
                        <button class="btn btn-secondary" @onclick="NavigateToEvents">Back to Events</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string Id { get; set; }

    private ChronicleEvent chronicleEvent;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadEvent();
    }

    private async Task LoadEvent()
    {
        loading = true;
        chronicleEvent = await ChronicleService.GetEventAsync(Id);
        loading = false;
    }

    private void NavigateToEvents()
    {
        NavigationManager.NavigateTo("/events");
    }

    private void EditEvent(string id)
    {
        NavigationManager.NavigateTo($"/events/edit/{id}");
    }

    private string FormatDescription(string description)
    {
        // Simple formatting - convert line breaks to HTML breaks
        if (string.IsNullOrEmpty(description)) return "";
        return description.Replace("\n", "<br />");
    }
}