@page "/todos"
@inject Services.FirebaseAuthService AuthService
@inject Services.FirestoreService FirestoreService
@inject NavigationManager NavigationManager
@using Models

<h3>Todo List</h3>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (currentUser == null)
{
    <p>Please <a href="login">log in</a> to see your todo items.</p>
}
else
{
    <div class="form-group">
        <input @bind="newTodoTitle" class="form-control" placeholder="Add a new todo..." />
        <button @onclick="AddTodoItem" class="btn btn-primary mt-2">Add</button>
    </div>

    <ul class="list-group mt-3">
        @foreach (var todo in todos)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <input type="checkbox" checked="@todo.IsCompleted" @onchange="e => ToggleTodo(todo, e.Value)" />
                    <span class="@(todo.IsCompleted ? "text-decoration-line-through" : "")">@todo.Title</span>
                </div>
                <button @onclick="() => DeleteTodo(todo.Id)" class="btn btn-sm btn-danger">Delete</button>
            </li>
        }
    </ul>
}

@code {
    private UserData currentUser;
    private List<TodoItem> todos = new List<TodoItem>();
    private string newTodoTitle = "";
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await AuthService.GetCurrentUserAsync();
        if (currentUser != null)
        {
            await LoadTodos();
        }
        isLoading = false;
    }

    private async Task LoadTodos()
    {
        var result = await FirestoreService.GetCollectionAsync<TodoItem>("todos");
        if (result.Success)
        {
            todos = result.Data.Where(t => t.UserId == currentUser.Uid).ToList();
        }
    }

    private async Task AddTodoItem()
    {
        if (string.IsNullOrWhiteSpace(newTodoTitle))
            return;

        var todo = new TodoItem
            {
                Title = newTodoTitle,
                IsCompleted = false,
                UserId = currentUser.Uid
            };

        var result = await FirestoreService.AddDocumentAsync("todos", todo);
        if (result.Success)
        {
            todo.Id = result.Id;
            todos.Add(todo);
            newTodoTitle = "";
        }
    }

    private async Task ToggleTodo(TodoItem todo, object isCompleted)
    {
        todo.IsCompleted = (bool)isCompleted;
        await FirestoreService.UpdateDocumentAsync("todos", todo.Id, todo);
    }

    private async Task DeleteTodo(string id)
    {
        await FirestoreService.DeleteDocumentAsync("todos", id);
        todos.RemoveAll(t => t.Id == id);
    }
}
